# Release builder: Ubuntu 20.04 (glibc 2.31) so the binary runs on HiveOS and Ubuntu 20.04+.
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake autoconf automake libtool pkg-config wget ca-certificates perl make \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
